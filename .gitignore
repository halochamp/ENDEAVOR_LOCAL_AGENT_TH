# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/

# Cython build artifacts
*.c
build/
*.so


# Tier 1 developer-only sources + build script
# NOTE: leading \ is required — a bare "#" starts a comment in .gitignore
\#developer/

# Local archive for retired compiled modules; never distribute it.
developer/

# Secrets / runtime state
.env
.agent_token

# Workspace + memory (user data, not source)
workspace/*
!workspace/.gitkeep
*.db
*.db-shm
*.db-wal
logs/

# Node (AGENT_UI Electron desktop client — user runs npm install themselves)
node_modules/
npm-debug.log*

# OS
.DS_Store
